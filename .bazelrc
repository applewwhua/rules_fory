common --enable_platform_specific_config

build --incompatible_strict_action_env

# Apache Fory requires C++17 (same flags as the upstream project).
build:linux --cxxopt=-std=c++17 --linkopt=-pthread
build:macos --cxxopt=-std=c++17 --linkopt=-pthread
build:windows --cxxopt=/std:c++17 --cxxopt=/Zc:preprocessor --cxxopt=/utf-8

test --test_output=errors
test --test_summary=detailed

# rules_fory resolves foryc through the @foryc repository generated by the
# extension in //fory/toolchains:extensions.bzl.  Override it with:
#   bazel build --repo_env=FORYC=/opt/foryc //...
