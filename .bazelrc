common --enable_platform_specific_config

build --incompatible_strict_action_env

# Apache Fory requires C++17 (same flags as the upstream project).
build:linux --cxxopt=-std=c++17 --linkopt=-pthread
build:macos --cxxopt=-std=c++17 --linkopt=-pthread
build:windows --cxxopt=/std:c++17 --cxxopt=/Zc:preprocessor --cxxopt=/utf-8

test --test_output=errors
test --test_summary=detailed

# Bazel 9 removed the native cc_* rules. The @fory C++ runtime is consumed as
# released and its upstream BUILD files call cc_binary()/cc_test() without a
# matching load(); autoload the removed rules for *external* repositories
# (autoloading stays disabled in the main repository, whose BUILD files all
# load from @rules_cc explicitly).
common --incompatible_autoload_externally=+cc_binary,+cc_import,+cc_library,+cc_shared_library,+cc_test

# The FDL-generated Python modules mirror the .fdl paths and rely on PEP 420
# namespace packages. Automatically created __init__.py files would make the
# mirrored package of one output directory shadow the packages of the other
# output directories, so __init__.py files must only be created explicitly.
build --@rules_python//python/config_settings:incompatible_default_to_explicit_init_py=true

# The code-generation driver (//tools:foryc_tool) imports foryc from the
# fory-compiler wheel pinned in //private:requirements_lock.txt; the first
# build needs network access to PyPI (and GitHub for the @fory C++ runtime).
