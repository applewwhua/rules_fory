"""Bazel module definition for rules_fory.

rules_fory brings Apache Fory (https://fory.apache.org) serialization to the
Bazel ecosystem.  It provides:

* `fory_library`      - language independent schema target (like `proto_library`)
* `cc_fory_library`   - C++ bindings           (like `cc_proto_library`)
* `py_fory_library`   - Python bindings        (like `py_proto_library`)

Supported Bazel version: 9.2 (bzlmod only, no WORKSPACE).
"""

module(
    name = "rules_fory",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_python", version = "1.7.0")

# Only needed to run the rules' own test suite.
bazel_dep(name = "bazel_skylib", version = "1.8.2", dev_dependency = True)

# Default toolchain: the `foryc` CLI of the pinned `fory-compiler` wheel,
# fetched from PyPI (see //fory/toolchains:requirements_lock.txt).
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "fory_pip",
    python_version = "3.11",
    requirements_lock = "//fory/toolchains:requirements_lock.txt",
)
use_repo(pip, "fory_pip")

# Fallback toolchain: a compiler that is already installed on the host, located
# through `foryc.configure(foryc = ...)`, `--repo_env=FORYC=/path/to/foryc`, or
# `$PATH`.
foryc = use_extension("//fory/toolchains:extensions.bzl", "foryc")
use_repo(foryc, "foryc")

register_toolchains("//fory/toolchains:foryc_pip_toolchain")
