load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_binary")
load(
    "@rules_fory//fory:defs.bzl",
    "cc_fory_library",
    "fory_library",
    "py_fory_library",
)

package(default_visibility = ["//visibility:public"])

# Language independent schema targets, the direct counterpart of proto_library.
fory_library(
    name = "address",
    srcs = ["address.fdl"],
)

fory_library(
    name = "person",
    srcs = ["person.fdl"],
    deps = [":address"],
)

# Fory runtimes vendored in third_party; in a real project they would usually
# be provided by the fory module of your choice, e.g. `runtime = "@fory//:fory"`.
cc_fory_library(
    name = "address_cc",
    deps = [":address"],
    runtime = "//third_party/fory:fory",
)

cc_fory_library(
    name = "person_cc",
    deps = [":person"],
    runtime = "//third_party/fory:fory",
)

py_fory_library(
    name = "address_py",
    deps = [":address"],
    runtime = "//third_party/pyfory:pyfory",
)

py_fory_library(
    name = "person_py",
    deps = [":person"],
    runtime = "//third_party/pyfory:pyfory",
)

# Convenience alias that exposes the generated headers in the runfiles of
# tests (the codegen target itself is an implementation detail).
filegroup(
    name = "person_cc_headers",
    srcs = [":_person_cc_fory_gen"],
)

# Serialize/deserialize round trip of the schemas above.
cc_binary(
    name = "main_cc",
    srcs = ["main.cc"],
    deps = [":person_cc"],
)

py_binary(
    name = "main_py",
    srcs = ["main.py"],
    main = "main.py",
    deps = [":person_py"],
)
