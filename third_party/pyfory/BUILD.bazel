load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

# Apache Fory Python runtime (`pyfory` 1.7.7), vendored from the
# pyfory-1.7.7-cp311-manylinux2014_x86_64 wheel.  The extension modules are
# prebuilt, so this library requires a CPython 3.11 interpreter, which is the
# default toolchain of rules_python.
py_library(
    name = "pyfory",
    srcs = glob(["pyfory/**/*.py"]),
    data = glob(["pyfory/**/*.so"]),
    imports = ["."],
)
