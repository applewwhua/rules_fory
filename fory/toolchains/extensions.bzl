"""Module extension that provides a locally installed `foryc` compiler.

The default toolchain of rules_fory does **not** use this extension: it runs
the `foryc` of the pinned `fory-compiler` wheel
(`//fory/toolchains:foryc_pip_toolchain`).  This extension is the escape hatch
for hosts that already have a compiler installed; it locates `foryc` (in this
order):

1. `foryc.configure(foryc = "/path/to/foryc")`
2. the `FORYC` environment variable (`--repo_env=FORYC=...`)
3. the first `foryc` found on `$PATH`

and exposes it as `@foryc`.  Select the matching toolchain explicitly with
`--extra_toolchains=//fory/toolchains:local_foryc_toolchain` (or register it
in `MODULE.bazel`).  The repository it creates is not hermetic: it is a thin
launcher around the local installation.
"""

_FORYC_SH = """#!/bin/sh
# Generated by rules_fory. Do not edit.
foryc="{foryc}"
if [ -z "$foryc" ] || [ ! -x "$foryc" ]; then
  echo "rules_fory: could not find the 'foryc' compiler." >&2
  echo "  Install it with: pip install fory-compiler" >&2
  echo "  or point rules_fory at it with: --repo_env=FORYC=/path/to/foryc" >&2
  exit 1
fi
exec "$foryc" "$@"
"""

_FORYC_BAT = """@echo off
setlocal
set "FORYC={foryc}"
if not exist "%FORYC%" (
  echo rules_fory: could not find the 'foryc' compiler. 1>&2
  echo Install it with: pip install fory-compiler 1>&2
  echo or point rules_fory at it with: --repo_env=FORYC=C:\\path\\to\\foryc.exe 1>&2
  exit /b 1
)
"%FORYC%" %*
"""

_BUILD = """\
exports_files(
    ["foryc.sh", "foryc.bat"],
    visibility = ["//visibility:public"],
)
"""

def _foryc_repository_impl(rctx):
    foryc = rctx.attr.foryc_path or rctx.os.environ.get("FORYC", "")
    if not foryc:
        which = rctx.which("foryc")
        if which:
            foryc = str(which)

    if foryc:
        # Store an absolute path so that the launcher also works from Bazel's
        # sandbox, where the working directory is the execroot.
        foryc = str(rctx.path(foryc))

    rctx.file(
        "foryc.sh",
        _FORYC_SH.format(foryc = foryc),
        executable = True,
    )
    rctx.file(
        "foryc.bat",
        _FORYC_BAT.format(foryc = foryc),
        executable = True,
    )
    rctx.file("BUILD.bazel", _BUILD)

_foryc_repository = repository_rule(
    implementation = _foryc_repository_impl,
    attrs = {
        "foryc_path": attr.string(
            doc = "Path to the foryc executable; empty means auto-detect.",
        ),
    },
    environ = ["FORYC"],
    local = True,
)

_configure = tag_class(
    attrs = {
        "foryc": attr.string(
            doc = "Path to the foryc executable. Empty means auto-detect.",
        ),
    },
)

def _foryc_extension_impl(module_ctx):
    foryc_path = ""
    for module in module_ctx.modules:
        for tag in module.tags.configure:
            if tag.foryc:
                foryc_path = tag.foryc
    _foryc_repository(name = "foryc", foryc_path = foryc_path)

foryc = module_extension(
    implementation = _foryc_extension_impl,
    tag_classes = {"configure": _configure},
    doc = "Provides the local `foryc` compiler as `@foryc`.",
)
