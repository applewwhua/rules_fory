load("@rules_python//python:defs.bzl", "py_binary")
load(":foryc_toolchain.bzl", "foryc_toolchain")

package(default_visibility = ["//visibility:public"])

toolchain_type(
    name = "foryc_toolchain_type",
    visibility = ["//visibility:public"],
)

# Default compiler: the `foryc` CLI of the pinned `fory-compiler` wheel, which
# is fetched from PyPI (see requirements_lock.txt) instead of relying on a host
# installation.
py_binary(
    name = "foryc_pip",
    srcs = ["foryc_main.py"],
    main = "foryc_main.py",
    deps = ["@fory_pip//fory_compiler"],
)

foryc_toolchain(
    name = "foryc_pip_impl",
    foryc = ":foryc_pip",
)

toolchain(
    name = "foryc_pip_toolchain",
    toolchain = ":foryc_pip_impl",
    toolchain_type = ":foryc_toolchain_type",
    visibility = ["//visibility:public"],
)

# Fallback: the locally installed compiler (`foryc.configure(foryc = ...)`,
# `$FORYC`, or the first `foryc` on `$PATH`).  Select it explicitly with
#   bazel build --extra_toolchains=//fory/toolchains:local_foryc_toolchain ...
foryc_toolchain(
    name = "local_foryc_impl",
    foryc = select({
        "@platforms//os:windows": "@foryc//:foryc.bat",
        "//conditions:default": "@foryc//:foryc.sh",
    }),
)

toolchain(
    name = "local_foryc_toolchain",
    toolchain = ":local_foryc_impl",
    toolchain_type = ":foryc_toolchain_type",
    visibility = ["//visibility:public"],
)
