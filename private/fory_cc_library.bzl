"""Implementation of `cc_fory_library` (the counterpart of `cc_proto_library`)."""

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc/common:cc_info.bzl", "CcInfo")
load("//:providers.bzl", "ForyInfo")
load("//private:common.bzl", "CC_GEN_SUFFIX", "merge_compilation_contexts")
load("//private:fory_cc_aspect.bzl", "fory_cc_aspect")

#: Fory C++ runtime, taken from the `fory` archive of MODULE.bazel (Apache Fory
#: ships Bazel BUILD files for cpp/ itself, so no overlay is needed).
DEFAULT_CC_RUNTIME = Label("@fory//cpp/fory/serialization:fory_serialization")

def _fdl_headers_impl(ctx):
    """Collects the C++ headers generated by the aspect for the closure."""
    contexts = [
        dep[CcInfo].compilation_context
        for dep in ctx.attr.deps
        if CcInfo in dep
    ]
    merged = merge_compilation_contexts(contexts)
    return [
        CcInfo(compilation_context = merged),
        DefaultInfo(files = merged.headers),
    ]

_fdl_headers = rule(
    implementation = _fdl_headers_impl,
    doc = """\
Internal rule that aggregates the headers of the `fory_library` closure.

`deps` carries the `fory_cc_aspect`, so every schema of the closure is
generated exactly once; this rule only merges the resulting compilation
contexts and hands the header files to the surrounding `cc_library`.
""",
    attrs = {
        "deps": attr.label_list(
            providers = [ForyInfo],
            allow_empty = True,
            aspects = [fory_cc_aspect],
            doc = "`fory_library` targets whose headers are needed.",
        ),
    },
)

def cc_fory_library(
        name,
        deps = [],
        runtime = None,
        **kwargs):
    """Generates C++ bindings for a set of `fory_library` targets.

    The result is a header only `cc_library`.  Generated headers mirror the
    path of their `.fdl` source inside the include directory of the schema
    target, so a header is included the way a protobuf header is:

    ```
    #include "example/shared/shared.fory.h"   // shared.fdl
    ```

    Args:
      name: name of the resulting `cc_library`.
      deps: `fory_library` targets that should be available to the bindings.
        The complete transitive closure of the schemas is generated, but every
        schema is generated only once (through `fory_cc_aspect`) - no matter
        how many `cc_fory_library` targets depend on it.
      runtime: optional `cc_library` that provides the Fory C++ runtime
        (`fory/serialization/fory.h`).  Defaults to the runtime of the `fory`
        module dependency of MODULE.bazel.
      **kwargs: forwarded to `cc_library` (for example `visibility`, `tags`,
        `testonly`).
    """
    headers_name = "_" + name + CC_GEN_SUFFIX
    _fdl_headers(
        name = headers_name,
        deps = deps,
        visibility = ["//visibility:private"],
        tags = kwargs.get("tags", []),
        testonly = kwargs.get("testonly", False),
    )

    cc_library(
        name = name,
        hdrs = [":" + headers_name],
        deps = [runtime if runtime else DEFAULT_CC_RUNTIME, ":" + headers_name],
        **kwargs
    )
