"""Implementation of `py_fory_library` (the counterpart of `py_proto_library`)."""

load("@rules_python//python:py_info.bzl", "PyInfo")
load("@rules_python//python:py_library.bzl", "py_library")
load("//:providers.bzl", "ForyInfo")
load("//private:common.bzl", "PY_GEN_SUFFIX")
load("//private:fory_py_aspect.bzl", "fory_py_aspect")

#: Fory Python runtime from the pip hub of MODULE.bazel.
DEFAULT_PY_RUNTIME = Label("@fory_pip//pyfory")

def _fdl_modules_impl(ctx):
    """Collects the Python modules generated by the aspect for the closure."""
    infos = [
        dep[PyInfo]
        for dep in ctx.attr.deps
        if PyInfo in dep
    ]
    sources = depset(transitive = [info.transitive_sources for info in infos])
    return [
        PyInfo(
            transitive_sources = sources,
            imports = depset(transitive = [info.imports for info in infos]),
            uses_shared_libraries = False,
        ),
        DefaultInfo(
            files = sources,
            runfiles = ctx.runfiles(transitive_files = sources),
        ),
    ]

_fdl_modules = rule(
    implementation = _fdl_modules_impl,
    doc = """\
Internal rule that aggregates the Python modules of the `fory_library` closure.

`deps` carries the `fory_py_aspect`, so every schema of the closure is
generated exactly once; this rule only merges the resulting PyInfo and hands
the generated files to the surrounding `py_library`.
""",
    attrs = {
        "deps": attr.label_list(
            providers = [ForyInfo],
            allow_empty = True,
            aspects = [fory_py_aspect],
            doc = "`fory_library` targets whose modules are needed.",
        ),
    },
)

def py_fory_library(
        name,
        deps = [],
        runtime = None,
        **kwargs):
    """Generates Python bindings for a set of `fory_library` targets.

    Generated modules mirror the path of their `.fdl` source inside the import
    directory of the schema target, so a module is imported the way a protobuf
    module is:

    ```
    from example.shared import shared_fory   # shared.fdl
    ```

    Args:
      name: name of the resulting `py_library`.
      deps: `fory_library` targets that should be available to the bindings.
        The complete transitive closure of the schemas is generated, but every
        schema is generated only once (through `fory_py_aspect`) - no matter
        how many `py_fory_library` targets depend on it.
      runtime: optional `py_library` that provides the `pyfory` runtime.  It is
        added as a dependency of the generated library and defaults to the
        `fory_pip` hub of MODULE.bazel.
      **kwargs: forwarded to `py_library` (for example `visibility`, `tags`,
        `testonly`).
    """
    modules_name = "_" + name + PY_GEN_SUFFIX
    _fdl_modules(
        name = modules_name,
        deps = deps,
        visibility = ["//visibility:private"],
        tags = kwargs.get("tags", []),
        testonly = kwargs.get("testonly", False),
    )

    py_library(
        name = name,
        # srcs: puts the generated modules into the runfiles of the library;
        # deps: brings in their import roots (PyInfo.imports) and the runtime.
        srcs = [":" + modules_name],
        deps = [runtime if runtime else DEFAULT_PY_RUNTIME, ":" + modules_name],
        **kwargs
    )
